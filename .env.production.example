# ==============================================================================
# AI Plant Care & Disease Detection System — Production Environment Variables
# ==============================================================================

# Application Core
APP_ENV=production
DEBUG=False
PORT=5000
SECRET_KEY=replace_with_a_cryptographically_secure_random_key_min_32_chars

# MongoDB Atlas (Recommended: Free M0 Cluster in ap-south-1 Mumbai)
# Format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://plantcare_user:StrongPassword123@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=plant_disease_db

# External API Integrations (Optional)
WEATHER_API_KEY=your_openweather_api_key
MAPS_API_KEY=your_google_maps_or_openrouteservice_key

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security & Session Hardening
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=2592000
